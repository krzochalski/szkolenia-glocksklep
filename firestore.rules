rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
                      request.resource.data.diff(resource.data).affectedKeys()
                        .hasOnly(['displayName', 'phoneNumber', 'email', 'fullName', 'bio', 'nip']);
      // Deletes go through /api/delete-user (Auth + profile); Admin SDK bypasses rules.
      allow delete: if false;
    }

    match /places/{placeId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /tags/{tagId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /instructors/{instructorId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /billingData/{billingId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    match /courseDescriptions/{slug} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /faq/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /regulamin/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /developmentPath/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /homepage/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /emailTemplates/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /contactRequests/{id} {
      allow create: if request.resource.data.keys().hasOnly([
                       'format', 'email', 'phone', 'message', 'status', 'createdAt'
                     ])
                     && request.resource.data.format in ['individual', 'group']
                     && request.resource.data.email is string
                     && request.resource.data.email.size() > 3
                     && request.resource.data.message is string
                     && request.resource.data.message.size() >= 5
                     && request.resource.data.message.size() <= 1000
                     && request.resource.data.status == 'new'
                     && request.resource.data.createdAt is string
                     && (!('phone' in request.resource.data)
                         || (request.resource.data.phone is string
                             && request.resource.data.phone.size() <= 40));
      allow read, update, delete: if isAdmin();
    }

    match /courseWaitingList/{entryId} {
      function waitingListEmailOk() {
        return request.resource.data.email is string
               && request.resource.data.email.size() > 3
               && request.resource.data.email.size() <= 254;
      }

      function guestWaitingListCreate() {
        return request.resource.data.keys().hasOnly([
                 'courseId', 'courseName', 'courseSlug',
                 'userName', 'email', 'createdAt', 'guest'
               ])
               && request.resource.data.guest == true
               && request.resource.data.courseId is string
               && request.resource.data.courseName is string
               && request.resource.data.courseSlug is string
               && request.resource.data.userName is string
               && request.resource.data.createdAt is string
               && waitingListEmailOk();
      }

      function authWaitingListCreate() {
        return isAuthenticated()
               && request.resource.data.userId == request.auth.uid
               && request.resource.data.keys().hasAll([
                    'courseId', 'courseName', 'courseSlug', 'userId',
                    'userName', 'email', 'createdAt'
                  ])
               && !('guest' in request.resource.data);
      }

      allow get: if isAuthenticated() &&
                   (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isAdmin() ||
                    (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create: if authWaitingListCreate() || guestWaitingListCreate();
      // Guests may overwrite their own course+email entry (deterministic id).
      allow update: if guestWaitingListCreate()
                      && resource.data.guest == true
                      && resource.data.email == request.resource.data.email
                      && resource.data.courseId == request.resource.data.courseId;
      allow delete: if isAuthenticated() &&
                      (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Enrollment mutates dates only via Admin SDK (Cloud Functions).
    match /courses/{courseId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();

      match /videos/{videoId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                       request.resource.data.authorId == request.auth.uid;
        allow update, delete: if isAdmin();
      }
    }

    match /{path=**} {
      allow read, write: if false;
    }
  }
}
