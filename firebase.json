{
	"firestore": {
		"rules": "firestore.rules",
		"indexes": "firestore.indexes.json"
	},
	"functions": [
		{
			"source": "functions",
			"codebase": "default",
			"ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "*.local"],
			"predeploy": ["pnpm --dir \"$RESOURCE_DIR\" run build"]
		}
	],
	"apphosting": {
		"backendId": "szkolenia",
		"rootDir": "/",
		"ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log", "functions"]
	},
	"auth": {
		"providers": {
			"emailPassword": true,
			"googleSignIn": {
				"oAuthBrandDisplayName": "Szkolenia Glocksklep",
				"supportEmail": "szkolenia@glocksklep.pl",
				"authorizedRedirectUris": [
					"https://szkolenia.glocksklep.pl",
					"https://szkolenia.glocksklep.pl/__/auth/handler",
					"https://szkolenia-glocksklep.firebaseapp.com",
					"https://szkolenia-glocksklep.firebaseapp.com/__/auth/handler",
					"http://localhost",
					"http://127.0.0.1"
				]
			}
		}
	}
}
