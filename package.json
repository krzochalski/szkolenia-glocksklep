{
	"name": "szkolenia-glocksklep",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"packageManager": "pnpm@12.4.2",
	"engines": {
		"node": "22"
	},
	"scripts": {
		"dev": "biome lint . && next dev -p 3417",
		"build": "biome lint . && next build",
		"lint": "biome lint .",
		"typecheck": "tsc --noEmit",
		"format": "biome lint . && biome format --write .",
		"check": "biome check --write .",
		"start": "next start",
		"test": "biome lint . && vitest --run",
		"test:unit": "vitest --run",
		"test:watch": "biome lint . && vitest",
		"verify": "biome lint . && tsc --noEmit && vitest --run",
		"deploy:all": "pnpm run build && pnpm --dir functions run build && npx -y firebase-tools@latest deploy --only apphosting,functions,firestore --project szkolenia-glocksklep",
		"deploy:functions": "pnpm --dir functions run build && npx -y firebase-tools@latest deploy --only functions --project szkolenia-glocksklep",
		"deploy:firestore:rules": "npx -y firebase-tools@latest deploy --only firestore:rules --project szkolenia-glocksklep",
		"functions:build": "pnpm --dir functions run build",
		"bootstrap:admin": "pnpm --dir functions exec tsx scripts/bootstrap-admin.ts",
		"seed:piotr-instructor": "pnpm --dir functions exec tsx scripts/seed-piotr-instructor.ts",
		"seed:faq": "pnpm --dir functions exec tsx scripts/seed-faq.ts",
		"seed:courses-from-rp-arms": "pnpm --dir functions exec tsx scripts/seed-courses-from-rp-arms.ts",
		"seed:places-from-rp-arms": "pnpm --dir functions exec tsx scripts/seed-places-from-rp-arms.ts",
		"deploy:auth": "npx -y firebase-tools@latest deploy --only auth --project szkolenia-glocksklep",
		"configure:auth": "pnpm --dir functions exec tsx scripts/configure-auth-settings.ts"
	},
	"dependencies": {
		"@emotion/cache": "^11.14.0",
		"@emotion/react": "11.14.0",
		"@emotion/styled": "11.14.1",
		"@stayfrosty/ui": "link:packages/ui",
		"@hookform/resolvers": "^5.9.1",
		"@mui/icons-material": "^9.4.0",
		"@mui/material": "^9.4.0",
		"@mui/material-nextjs": "^9.4.0",
		"@tanstack/react-query": "^5.102.8",
		"dayjs": "^1.11.18",
		"firebase": "^12.19.0",
		"next": "^16.3.5",
		"react": "19.3.0",
		"react-cookie-consent": "10.0.2",
		"react-dom": "19.3.0",
		"react-hook-form": "^7.88.0",
		"react-markdown": "^10.1.0",
		"remark-breaks": "^4.0.0",
		"remark-gfm": "^4.0.1",
		"uuid": "^13.0.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@testing-library/dom": "^10.4.2",
		"@testing-library/jest-dom": "^7.0.1",
		"@testing-library/react": "^16.3.3",
		"@types/node": "26.5.1",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@types/uuid": "^10.0.0",
		"fast-check": "^4.10.0",
		"jsdom": "^30.0.1",
		"tsx": "4.23.13",
		"typescript": "^7.0.2",
		"vitest": "^5.0.1"
	}
}
