# SMTP for transactional emails (loaded by Firebase Functions / emulator)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# Full Google account email that sends mail
SMTP_USER=zamowienia@glocksklep.pl
# Google App Password (16 chars) — NOT your normal login password
# Create: https://myaccount.google.com/apppasswords
SMTP_PASS=
# Optional From address (defaults to SMTP_USER)
MAIL_FROM=zamowienia@glocksklep.pl
# Auto proforma PDF e-mail after paid enroll (default: on). Set false to disable.
PROFORMA_EMAIL_ENABLED=true
# Shared with App Hosting for catalog ISR purge (Secret Manager in prod).
REVALIDATE_SECRET=
# Optional override for revalidate target (default: https://szkolenia.glocksklep.pl)
SITE_ORIGIN=https://szkolenia.glocksklep.pl
